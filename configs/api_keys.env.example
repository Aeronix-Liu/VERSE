# VERSE — API keys (fill-in entry point)
# ---------------------------------------------------------------------------
# 1) Copy this file:      cp configs/api_keys.env.example configs/api_keys.env
# 2) Fill in your key(s) below.
# 3) Run training normally — scripts/train_self_evolve.sh auto-loads it.
#
# `configs/api_keys.env` is gitignored, so your real keys are NEVER committed.
# ---------------------------------------------------------------------------

# REQUIRED (self-evolve stage): an OpenAI-compatible chat/VLM endpoint used by the
# reward judges (invalid-question explanation + observation-quality scoring) and by
# DGE entity extraction. Works with OpenAI, vLLM/SGLang OpenAI servers, Volcengine
# Ark, DashScope, etc. Leave the key empty to disable the LLM judges (those reward
# terms degrade to 0; the core outcome + process rewards still work).
VERSE_VLM_API_KEY=
VERSE_VLM_BASE_URL=https://api.openai.com/v1
VERSE_VLM_MODEL=gpt-4o-mini

# OPTIONAL: Weights & Biases logging. Leave empty to log to local files only.
WANDB_API_KEY=
