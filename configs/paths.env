# VERSE — central path configuration.
# All scripts source this file. Edit ONLY this file to relocate the project;
# nothing else hard-codes absolute paths. Then: `source configs/paths.env`.

# Repository root (auto-detected if unset; override if sourcing from elsewhere).
export VERSE_ROOT="${VERSE_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")/.." && pwd)}"

# Base VLM (Qwen2.5-VL-7B-Instruct). Point to a local dir or an HF id.
export VERSE_BASE_MODEL="${VERSE_BASE_MODEL:-Qwen/Qwen2.5-VL-7B-Instruct}"

# Where downloaded data / checkpoints / benchmarks land (kept OUT of the repo;
# these hold the large images/weights). Default: a sibling `assets/` dir.
export VERSE_ASSETS="${VERSE_ASSETS:-${VERSE_ROOT}/assets}"
export VERSE_DATA="${VERSE_DATA:-${VERSE_ASSETS}/data}"                 # SFT annotations + images
export VERSE_CONTEXT="${VERSE_CONTEXT:-${VERSE_ASSETS}/selfevolve_context}" # ScanNet frames + maze pool
export VERSE_CKPT="${VERSE_CKPT:-${VERSE_ASSETS}/checkpoints}"          # cs-3258 / rrs-744 / your runs
export VERSE_BENCH="${VERSE_BENCH:-${VERSE_ASSETS}/benchmark}"          # VSI / SPAR / MAZE eval data
export VERSE_OUTPUT="${VERSE_OUTPUT:-${VERSE_ROOT}/outputs}"            # training/eval outputs

# HuggingFace Hub namespace for VERSE releases (data + base checkpoints).
export VERSE_HF_NAMESPACE="${VERSE_HF_NAMESPACE:-Aeronix-zzz}"
export VERSE_HF_DATA_REPO="${VERSE_HF_DATA_REPO:-${VERSE_HF_NAMESPACE}/VERSE-data}"
export VERSE_HF_CTX_REPO="${VERSE_HF_CTX_REPO:-${VERSE_HF_NAMESPACE}/VERSE-selfevolve-context}"
export VERSE_HF_COLDSTART_REPO="${VERSE_HF_COLDSTART_REPO:-${VERSE_HF_NAMESPACE}/VERSE-cold-start-7B}"
export VERSE_HF_RRS_REPO="${VERSE_HF_RRS_REPO:-${VERSE_HF_NAMESPACE}/VERSE-rrs-7B}"

# China mirror for DOWNLOADS (do not use for uploads — uploads target real HF).
export HF_ENDPOINT="${HF_ENDPOINT:-https://hf-mirror.com}"

# GPUs to use (this project convention: 4-7). Override as needed.
export VERSE_GPUS="${VERSE_GPUS:-0,1,2,3}"
