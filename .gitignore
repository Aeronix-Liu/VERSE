# Secrets / credentials — NEVER commit. Provide your own via env or a local .env.
*.env
!*.env.example
# paths.env is path/namespace config only (no secrets); must be on its own line
# or git treats trailing spaces as part of the pattern and keeps ignoring it.
!configs/paths.env
**/config/api_secrets.env
**/config/wandb.env
**/config/*secret*
*.key
*.pem

# Large artifacts — never commit (downloaded/produced at runtime).
assets/
outputs/
third_party/
*.safetensors
*.pt
*.bin
*.tokenized*
wandb/
logs/
*.log

# Python
__pycache__/
*.pyc
.venv/
.ipynb_checkpoints/

# Rendered configs
*.rendered.yaml

# OS
.DS_Store

# --- open-source hygiene (added for release): exclude training data & dev artifacts ---
# Self-evolve context manifests + legacy training data (regenerated by build_* scripts
# or fetched via scripts/download_context.sh). Keep small schedule/spec JSONs.
self_evolve/easy_r1/dataset/*.jsonl
self_evolve/**/spatialevo_train*.jsonl
self_evolve/**/scannet_*_multi_frame*.jsonl
# Legacy training-curve dumps / dashboards (dev artifacts, not needed to reproduce).
self_evolve/training_curve/
# Large compat dumps.
self_evolve/run_scripts/dge_grpo_compat.json
self_evolve/**/dge_compat_full.log
# ScanNet / maze image assets (fetched via download_context.sh).
**/ScanNetData_local/
**/ScanNetData/
**/maze_pool/*.png

# Local publishing files
*.bak
.release-local/
